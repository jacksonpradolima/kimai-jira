# Copy this file to `.env` for local scripts/tooling that need these values.
# NEVER commit a real `.env` file. Production secrets belong in the Forge
# Secret Store (see docs/security.md), not in this repository or in GitHub.

# Base URL of the self-hosted Kimai instance used for local development.
KIMAI_URL=https://kimai.example.com

# Kimai API token used only for local/manual testing against a dev Kimai
# instance. Leave empty in version control.
KIMAI_TOKEN=

# Shared secret used to validate incoming Kimai webhook requests.
KIMAI_WEBHOOK_SECRET=

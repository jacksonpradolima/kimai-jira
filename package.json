{
  "name": "kimai-for-jira",
  "version": "1.1.1",
  "description": "Open-source Kimai integration for Jira Cloud, built with Atlassian Forge",
  "license": "MIT",
  "private": true,
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test && npm run docs:ui:check",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --ci --coverage",
    "test:watch": "jest --watch",
    "docs:ui": "tsx scripts/ui-docs/generate.ts",
    "docs:ui:check": "tsx scripts/ui-docs/generate.ts --check",
    "forge:lint": "forge lint"
  },
  "dependencies": {
    "@forge/api": "^8.3.0",
    "@forge/bridge": "^7.2.0",
    "@forge/kvs": "^2.1.0",
    "@forge/react": "^12.3.1",
    "@forge/resolver": "^2.0.0"
  },
  "devDependencies": {
    "@forge/cli": "^14.2.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@playwright/test": "^1.64.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
